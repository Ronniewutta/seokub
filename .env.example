# SEOKUB environment configuration
# Copy this file to .env.local and fill in your values.

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Public site URL (used by sitemap.xml and robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (SQLite for local dev — switch to PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Dev-only email login (no password) — enabled automatically when NODE_ENV
# is not "production". Set to "true" to force-enable in production (not recommended).
# ENABLE_DEV_LOGIN=true
