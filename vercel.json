{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/audits/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/audits/[id]/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/recurring-audits",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/keyword-rankings",
      "schedule": "0 6 * * *"
    }
  ]
}
